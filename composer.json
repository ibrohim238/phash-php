{
    "name": "ibrohim238/phash",
    "description": "Перцептивный хеш изображений, совпадающий бит в бит с imagehash.phash(hash_size=12, highfreq_factor=12) на Pillow 9.4.0",
    "type": "library",
    "version": "0.2.0",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-gd": "*",
        "ext-imagick": "*",
        "ext-json": "*",
        "ext-phashext": "^0.1.1",
        "ext-zlib": "*",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.15",
        "phpunit/phpunit": "^11.5.44"
    },
    "autoload": {
        "psr-4": {
            "Ibrohim238\\Phash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ibrohim238\\Phash\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ibrohim238\\Phash\\PhashServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
